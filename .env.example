# ================================================================
# Uganda Prisons Service Products Store - Environment Configuration
# Copy this file to .env and fill in your production credentials
# ================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-key-in-production

# Default Admin Account (used only on initial empty DB seed)
ADMIN_EMAIL=admin@prisons.go.ug
ADMIN_PASSWORD=UPSAdmin@2026
ADMIN_NAME=Sales Administrator

# Database: Leave DATABASE_URL blank to use local SQLite automatically.
# On Render, PostgreSQL DATABASE_URL is automatically provided via render.yaml.
DATABASE_URL=

# ================================================================
# AWS S3 Storage Configuration (Products, Adverts, Proof of Payment)
# If left empty, uploads automatically save to local ./uploads/ folder
# ================================================================
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom CDN/CloudFront or S3 public base URL
AWS_S3_PUBLIC_URL=

# ================================================================
# Yoola SMS Configuration (Uganda SMS Gateway)
# Endpoint: https://yoolasms.com/api/v1/send
# ================================================================
YOOLA_SMS_API_KEY=
YOOLA_SMS_SENDER_ID=UPS-STORE
YOOLA_SMS_SANDBOX=true
YOOLA_SMS_API_URL=https://yoolasms.com/api/v1/send
