{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://uganda-prisons-service-store.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://uganda-prisons-service-store.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|images/|api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
